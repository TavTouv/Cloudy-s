<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cloudy’s</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">

<!--
  ========================  RÉGLAGES  ========================
  CSV_URL   : URL CSV de ta Google Sheet (Fichier → Partager → Publier sur le Web → CSV)
  PAYPAL_ID : ton Client ID PayPal (developer.paypal.com → Apps & Credentials, mode « Live »)
  Colonnes de la Sheet : nom | prix | description | image | categorie | stock | badge
  - prix  : 24,90 ou 24.90
  - image : lien vers l’image, ou chemin dans ton dépôt GitHub (ex. images/tapis.jpg)
  - stock : vide, ou 0 pour « Épuisé »
  - badge : facultatif (ex. Nouveau, Édition limitée)
  ============================================================
-->
<script>
  const CONFIG = {
    NOM_BOUTIQUE: "Cloudy’s",
    SLOGAN: "Goodies doux et précieux, imprimés à la demande",
    API_URL: "",       // ← URL de ton Apps Script (se termine par /exec) : prioritaire sur CSV_URL
    CSV_URL: "",
    PAYPAL_ID: "",     // ← Client ID PayPal uniquement (jamais le Secret)
    DEVISE: "EUR"
  };
</script>

<style>
  :root {
    --porcelain: #fdfbfc;
    --pearl: #f6eef3;
    --line: #ecdde6;
    --blush: #f9cfe0;
    --rose: #e389b0;
    --baby: #cfe8f6;
    --sky: #9fd2ee;
    --ink: #5b4a5f;
    --ink-soft: #94818f;
    --focus: #7fb9dd;
    color-scheme: light;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --porcelain: #1f1b29; --pearl: #2a2436; --line: #3d3449;
      --blush: #6e4a62; --rose: #f2a9c9; --baby: #33475e; --sky: #8cc6e6;
      --ink: #f4e9f0; --ink-soft: #c2b0bf; --focus: #a8d6f2;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --porcelain: #1f1b29; --pearl: #2a2436; --line: #3d3449;
    --blush: #6e4a62; --rose: #f2a9c9; --baby: #33475e; --sky: #8cc6e6;
    --ink: #f4e9f0; --ink-soft: #c2b0bf; --focus: #a8d6f2;
    color-scheme: dark;
  }

  *, *::before, *::after { box-sizing: inherit; }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  body {
    margin: 0; background: var(--porcelain); color: var(--ink);
    font-family: "Quicksand", "Nunito", system-ui, sans-serif; font-weight: 500;
    line-height: 1.6; overflow-x: hidden;
  }
  img { max-width: 100%; display: block; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 3px; border-radius: 999px; }
  .serif { font-family: "Cormorant Garamond", "Garamond", "Times New Roman", serif; }

  /* ---------- Barre du haut ---------- */
  .topbar {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12px;
    max-width: 1180px; margin: 0 auto; padding: 18px 20px;
  }
  .brand-small { grid-column: 2; font-family: "Cormorant Garamond", serif; font-style: italic; font-size: 1.6rem; color: var(--rose); text-decoration: none; }
  .search {
    grid-column: 3; justify-self: end; width: min(220px, 100%);
    font: inherit; font-size: .9rem; color: var(--ink);
    padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--pearl);
  }
  .search::placeholder { color: var(--ink-soft); }

  /* ---------- Bannière aquarelle ---------- */
  .hero {
    position: relative; margin: 0 auto; max-width: 1180px; height: clamp(300px, 52vw, 480px);
    border-radius: 0 0 40px 40px; overflow: hidden; isolation: isolate;
    background:
      radial-gradient(60% 70% at 18% 30%, var(--blush) 0, transparent 70%),
      radial-gradient(55% 65% at 82% 25%, var(--baby) 0, transparent 70%),
      radial-gradient(70% 60% at 60% 95%, var(--sky) 0, transparent 70%),
      radial-gradient(50% 50% at 10% 100%, var(--baby) 0, transparent 70%),
      var(--pearl);
  }
  .puff { position: absolute; border-radius: 50%; background: var(--porcelain); filter: blur(22px); opacity: .85; z-index: -1; }
  .p1 { width: 340px; height: 120px; left: -60px; bottom: 30px; }
  .p2 { width: 280px; height: 90px; right: -40px; top: 60px; opacity: .7; }
  .p3 { width: 420px; height: 140px; left: 40%; bottom: -60px; }
  .hero-inner { position: absolute; inset: 0; display: grid; place-content: center; text-align: center; padding: 20px; }
  .hero h1 {
    margin: 0; font-family: "Cormorant Garamond", serif; font-style: italic; font-weight: 400;
    font-size: clamp(4rem, 15vw, 9.5rem); line-height: .9; color: var(--ink); letter-spacing: -.01em;
    animation: settle 1.6s ease-out both;
  }
  .hero p { margin: 18px auto 0; max-width: 34ch; color: var(--ink-soft); font-size: clamp(.95rem, 2.6vw, 1.1rem); }
  @keyframes settle { from { opacity: 0; transform: translateY(14px); filter: blur(6px); } to { opacity: 1; transform: none; filter: none; } }

  /* ---------- Collection ---------- */
  main { max-width: 1180px; margin: 0 auto; padding: 56px 20px 80px; }
  .intro { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 18px; margin-bottom: 36px; }
  .intro h2 { margin: 0; font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: clamp(2rem, 5vw, 2.8rem); line-height: 1.1; }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .tab {
    font: inherit; font-size: .9rem; font-weight: 600; cursor: pointer;
    padding: 7px 18px; border-radius: 999px; border: 1px solid var(--line); background: transparent; color: var(--ink-soft);
  }
  .tab:nth-child(even)[aria-pressed="true"] { background: var(--baby); border-color: var(--baby); color: var(--ink); }
  .tab:nth-child(odd)[aria-pressed="true"]  { background: var(--blush); border-color: var(--blush); color: var(--ink); }

  .notice { margin: 0 0 32px; padding: 12px 18px; border-radius: 16px; background: var(--pearl); border: 1px solid var(--line); color: var(--ink-soft); font-size: .9rem; }

  .grid { display: grid; gap: 52px 28px; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); }
  .product { display: flex; flex-direction: column; }
  .visual {
    position: relative; aspect-ratio: 3 / 4; border-radius: 28px; overflow: hidden; background: var(--pearl);
    display: grid; place-items: center;
  }
  .visual img { width: 100%; height: 100%; object-fit: cover; transition: transform .8s ease; }
  .product:hover .visual img { transform: scale(1.03); }
  .visual.placeholder.pink { background: radial-gradient(80% 70% at 30% 20%, var(--blush), var(--pearl)); }
  .visual.placeholder.blue { background: radial-gradient(80% 70% at 70% 20%, var(--baby), var(--pearl)); }
  .monogram { font-family: "Cormorant Garamond", serif; font-style: italic; font-size: 5rem; color: var(--porcelain); opacity: .95; }
  .badge {
    position: absolute; top: 14px; left: 14px; padding: 4px 12px; border-radius: 999px;
    background: var(--porcelain); color: var(--rose); font-size: .78rem; font-weight: 700;
  }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-top: 16px; }
  .product h3 { margin: 0; font-family: "Cormorant Garamond", serif; font-weight: 500; font-size: 1.45rem; line-height: 1.15; }
  .price { white-space: nowrap; font-weight: 600; color: var(--ink); }
  .cat { margin: 4px 0 0; font-size: .82rem; color: var(--rose); font-weight: 600; }
  .desc { margin: 8px 0 16px; font-size: .92rem; color: var(--ink-soft); flex: 1; }
  .pay { min-height: 44px; }
  .pay-placeholder, .soldout { padding: 10px; border-radius: 999px; text-align: center; font-size: .85rem; font-weight: 600; }
  .pay-placeholder { border: 1px dashed var(--sky); color: var(--ink-soft); }
  .soldout { background: var(--pearl); color: var(--ink-soft); }
  .empty { grid-column: 1 / -1; text-align: center; color: var(--ink-soft); padding: 40px 0; }

  footer { border-top: 1px solid var(--line); max-width: 1180px; margin: 0 auto; padding: 36px 20px 56px; text-align: center; color: var(--ink-soft); font-size: .88rem; }
  footer .serif { font-style: italic; font-size: 1.8rem; color: var(--rose); margin: 0 0 14px; }
  footer nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px 26px; margin-bottom: 12px; }
  footer a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--blush); }

  /* ---------- Confirmation ---------- */
  .modal { position: fixed; inset: 0; display: none; place-items: center; padding: 20px; z-index: 20; background: rgba(91, 74, 95, .3); backdrop-filter: blur(6px); }
  .modal.open { display: grid; }
  .modal-box { background: var(--porcelain); border: 1px solid var(--line); border-radius: 32px; padding: 38px 30px 30px; max-width: 380px; text-align: center; animation: rise .4s ease-out; }
  .modal-box h2 { margin: 0 0 10px; font-family: "Cormorant Garamond", serif; font-style: italic; font-weight: 500; font-size: 2.3rem; color: var(--rose); }
  .modal-box p { margin: 0 0 22px; color: var(--ink-soft); }
  .btn { font: inherit; font-weight: 600; cursor: pointer; border: 0; border-radius: 999px; padding: 11px 26px; background: var(--baby); color: var(--ink); }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  @media (max-width: 560px) {
    .topbar { grid-template-columns: 1fr; text-align: center; }
    .brand-small, .search { grid-column: 1; justify-self: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero h1, .modal-box { animation: none; }
    .visual img { transition: none; }
  }
</style>
</head>
<body>

<div class="topbar">
  <a class="brand-small" href="#" id="brandSmall"></a>
  <input class="search" id="search" type="search" placeholder="Rechercher un produit" aria-label="Rechercher un produit">
</div>

<header class="hero">
  <div class="puff p1"></div><div class="puff p2"></div><div class="puff p3"></div>
  <div class="hero-inner">
    <h1 id="shopName"></h1>
    <p id="slogan"></p>
  </div>
</header>

<main>
  <div class="intro">
    <h2>La collection</h2>
    <div class="tabs" id="tabs" role="group" aria-label="Filtrer par catégorie"></div>
  </div>
  <div id="notice"></div>
  <section class="grid" id="grid" aria-live="polite">
    <p class="empty">Chargement de la collection…</p>
  </section>
</main>

<footer>
  <p class="serif" id="brandFooter"></p>
  <nav>
    <a href="#">Mentions légales</a>
    <a href="#">Conditions de vente</a>
    <a href="#">Livraison et retours</a>
    <a href="#">Contact</a>
  </nav>
  <p>Paiement sécurisé par PayPal. Droit de rétractation de 14 jours.</p>
</footer>

<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
  <div class="modal-box">
    <h2 id="modalTitle">Merci</h2>
    <p id="modalText">Ta commande est confirmée. PayPal t’envoie un reçu par e-mail.</p>
    <button class="btn" id="modalClose">Continuer mes achats</button>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script>
  const DEMO = [
    { nom: "Tapis Mer de nuages", prix: "24,90", description: "Format XXL 90 × 40 cm, base antidérapante, bords cousus.", categorie: "Tapis de souris", badge: "Nouveau", stock: "" },
    { nom: "Tapis Aube poudrée", prix: "24,90", description: "Dégradé rose et bleu layette pour un bureau tout doux.", categorie: "Tapis de souris", badge: "", stock: "" },
    { nom: "Stickers Ciel de soie", prix: "6,50", description: "12 stickers vinyle, finition satinée, résistants à l’eau.", categorie: "Papeterie", badge: "", stock: "" },
    { nom: "Mug Pétale", prix: "16,00", description: "Céramique 330 ml, compatible lave-vaisselle.", categorie: "Maison", badge: "", stock: "" },
    { nom: "Tote bag Cloudy’s", prix: "18,00", description: "Coton bio épais, assez grand pour un ordinateur portable.", categorie: "Accessoires", badge: "Édition limitée", stock: "0" },
    { nom: "Porte-clés Perle de nuage", prix: "8,90", description: "Acrylique double face de 6 cm, anneau doré.", categorie: "Accessoires", badge: "", stock: "" }
  ];

  let produits = [], filtre = "Tout", recherche = "";

  ["shopName", "brandSmall", "brandFooter"].forEach(id => document.getElementById(id).textContent = CONFIG.NOM_BOUTIQUE);
  document.getElementById("slogan").textContent = CONFIG.SLOGAN;
  document.title = CONFIG.NOM_BOUTIQUE;

  const esc = s => String(s ?? "").replace(/[&<>"']/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
  const prixNombre = p => { const n = parseFloat(String(p).replace(/\s|€/g, "").replace(",", ".")); return isNaN(n) ? 0 : n; };
  const prixAffiche = n => new Intl.NumberFormat("fr-FR", { style: "currency", currency: CONFIG.DEVISE }).format(n);

  function charger() {
    if (CONFIG.API_URL) {
      return fetch(CONFIG.API_URL + "?action=produits")
        .then(r => r.json())
        .then(d => { if (!d.ok) throw new Error(d.erreur); demarrer(d.produits); })
        .catch(() => { afficherNotice("La collection n’a pas pu être chargée. Vérifie l’URL API_URL et le déploiement Apps Script."); demarrer([]); });
    }
    if (!CONFIG.CSV_URL) {
      afficherNotice("Produits d’exemple affichés. Colle l’URL CSV de ta Google Sheet dans CONFIG pour afficher ta collection.");
      return demarrer(DEMO);
    }
    Papa.parse(CONFIG.CSV_URL, {
      download: true, header: true, skipEmptyLines: true,
      transformHeader: h => h.trim().toLowerCase(),
      complete: res => demarrer(res.data.filter(p => p.nom)),
      error: () => { afficherNotice("La Google Sheet n’a pas pu être lue. Vérifie qu’elle est publiée sur le Web au format CSV."); demarrer([]); }
    });
  }
  function afficherNotice(t) { document.getElementById("notice").innerHTML = `<p class="notice">${esc(t)}</p>`; }

  function demarrer(liste) {
    produits = liste.map((p, i) => ({ ...p, id: p.id || i, prixN: prixNombre(p.prix) }));
    construireOnglets(); afficher();
  }

  function construireOnglets() {
    const cats = ["Tout", ...new Set(produits.map(p => (p.categorie || "").trim()).filter(Boolean))];
    const box = document.getElementById("tabs");
    if (cats.length < 3) { box.innerHTML = ""; return; }
    box.innerHTML = cats.map(c => `<button class="tab" aria-pressed="${c === filtre}" data-cat="${esc(c)}">${esc(c)}</button>`).join("");
    box.querySelectorAll(".tab").forEach(b => b.onclick = () => { filtre = b.dataset.cat; construireOnglets(); afficher(); });
  }

  document.getElementById("search").addEventListener("input", e => { recherche = e.target.value.trim().toLowerCase(); afficher(); });

  function afficher() {
    const grid = document.getElementById("grid");
    const liste = produits.filter(p =>
      (filtre === "Tout" || (p.categorie || "").trim() === filtre) &&
      (!recherche || (p.nom + " " + (p.description || "")).toLowerCase().includes(recherche)));
    if (!liste.length) {
      grid.innerHTML = recherche
        ? `<p class="empty">Aucun produit ne correspond à « ${esc(recherche)} ».</p>`
        : `<p class="empty">La collection est vide. Ajoute une ligne dans ta Google Sheet pour la voir ici.</p>`;
      return;
    }
    grid.innerHTML = liste.map((p, i) => {
      const epuise = String(p.stock).trim() === "0";
      const visuel = p.image
        ? `<div class="visual"><img src="${esc(p.image)}" alt="${esc(p.nom)}" loading="lazy">`
        : `<div class="visual placeholder ${i % 2 ? "blue" : "pink"}"><span class="monogram" aria-hidden="true">${esc(p.nom.trim().charAt(0))}</span>`;
      const badge = p.badge ? `<span class="badge">${esc(p.badge)}</span>` : "";
      const paiement = epuise ? `<div class="soldout">Épuisé</div>`
        : CONFIG.PAYPAL_ID ? `<div class="pay" id="pp-${p.id}"></div>`
        : `<div class="pay-placeholder">Bouton PayPal à configurer</div>`;
      return `
        <article class="product">
          ${visuel}${badge}</div>
          <div class="meta"><h3>${esc(p.nom)}</h3><span class="price">${prixAffiche(p.prixN)}</span></div>
          ${p.categorie ? `<p class="cat">${esc(p.categorie)}</p>` : ""}
          <p class="desc">${esc(p.description)}</p>
          ${paiement}
        </article>`;
    }).join("");
    if (CONFIG.PAYPAL_ID) chargerPaypal().then(() => liste.forEach(rendreBouton));
  }

  let paypalPromesse;
  function chargerPaypal() {
    if (!paypalPromesse) paypalPromesse = new Promise((ok, ko) => {
      const s = document.createElement("script");
      s.src = `https://www.paypal.com/sdk/js?client-id=${encodeURIComponent(CONFIG.PAYPAL_ID)}&currency=${CONFIG.DEVISE}&locale=fr_FR`;
      s.onload = ok; s.onerror = ko; document.head.appendChild(s);
    });
    return paypalPromesse;
  }

  function rendreBouton(p) {
    const el = document.getElementById("pp-" + p.id);
    if (!el || el.childElementCount) return;
    paypal.Buttons({
      fundingSource: paypal.FUNDING.PAYPAL,
      style: { shape: "pill", color: "white", height: 44, label: "paypal" },
      createOrder: (d, actions) => actions.order.create({
        purchase_units: [{ description: p.nom.slice(0, 127), amount: { currency_code: CONFIG.DEVISE, value: p.prixN.toFixed(2) } }]
      }),
      onApprove: (d, actions) => actions.order.capture().then(details => {
        if (CONFIG.API_URL) {
          fetch(CONFIG.API_URL, {
            method: "POST",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify({ action: "commande", orderId: d.orderID, produitId: p.id })
          }).then(() => charger()).catch(err => console.error("Commande non enregistrée :", err));
        }
        const prenom = details?.payer?.name?.given_name;
        document.getElementById("modalTitle").textContent = prenom ? `Merci ${prenom}` : "Merci";
        document.getElementById("modalText").textContent = `Ta commande « ${p.nom} » est confirmée. PayPal t’envoie un reçu par e-mail.`;
        ouvrirModal();
      }),
      onError: () => afficherNotice("Le paiement n’a pas abouti. Aucun montant n’a été débité, tu peux réessayer.")
    }).render(el);
  }

  const modal = document.getElementById("modal");
  function ouvrirModal() { modal.classList.add("open"); document.getElementById("modalClose").focus(); }
  function fermerModal() { modal.classList.remove("open"); }
  document.getElementById("modalClose").onclick = fermerModal;
  modal.addEventListener("click", e => { if (e.target === modal) fermerModal(); });
  document.addEventListener("keydown", e => { if (e.key === "Escape") fermerModal(); });

  charger();
</script>
</body>
</html>
